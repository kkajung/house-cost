# 이 파일은 예시 템플릿입니다. 실제 값은 여기 쓰지 말고,
# 이 파일을 복사해 ".streamlit/secrets.toml" (git에 올라가지 않음, .gitignore로 제외됨)로 만든 뒤
# 아래 값을 실제 값으로 채워 넣으세요.
#
# 로컬 실행: 이 폴더에 secrets.toml 파일만 만들면 자동으로 적용됩니다.
# Streamlit Community Cloud 배포: 앱 대시보드 → Settings → Secrets 에 동일한 내용을 붙여넣으세요
# (secrets.toml 파일 자체를 올리는 게 아니라, 이 내용을 그대로 텍스트로 붙여넣는 방식입니다).

APP_PASSWORD = "여기에_원하는_비밀번호"
DATA_GO_KR_SERVICE_KEY = "여기에_공공데이터포털에서_발급받은_인증키(Decoding 키 권장)"

# --- 여러 기기(컴퓨터/휴대폰)에서 저장한 물건을 공유하려면 Google Sheets 연동 ---
# 설정 방법은 README 또는 대화 내 안내를 참고하세요.
GSHEET_ID = "여기에_구글시트_URL의_긴_ID_문자열"

[gcp_service_account]
type = "service_account"
project_id = "여기에_project_id"
private_key_id = "여기에_private_key_id"
private_key = "-----BEGIN PRIVATE KEY-----\n여기에_private_key\n-----END PRIVATE KEY-----\n"
client_email = "여기에_서비스계정_이메일@xxx.iam.gserviceaccount.com"
client_id = "여기에_client_id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "여기에_client_x509_cert_url"
